<Project>

  <!-- =========================================================
       T003 — Solution-wide .NET build settings
       All .NET projects inherit these unless they override them.
       ========================================================= -->

  <PropertyGroup>
    <!-- Zero-warning, zero-diagnostic build policy (Constitution Principle I) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Enforce .NET analyzers at Recommended+ ruleset -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- All projects use net10.0; WPF projects override to net10.0-windows -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <EmbedAllSources>true</EmbedAllSources>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Test assemblies are executable verification artifacts, not shipped API libraries. Their
         public xUnit methods are discovered by reflection and do not form a consumer contract. -->
    <GenerateDocumentationFile Condition="$(MSBuildProjectName.EndsWith('.Tests'))">false</GenerateDocumentationFile>

  </PropertyGroup>

  <!-- Package versions are centrally managed in Directory.Packages.props via CPM.
       This file retains only build settings that apply to all projects. -->

</Project>
