<Project>

  <!-- =========================================================
       T003 — Solution-wide .NET build settings
       All .NET projects inherit these unless they override them.
       ========================================================= -->

  <PropertyGroup>
    <!-- Zero-warning, zero-diagnostic build policy (Constitution Principle I) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Enforce .NET analyzers at Recommended+ ruleset -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- All projects use net10.0; WPF projects override to net10.0-windows -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <!-- Shared package versions — pin once, consume everywhere -->
  <ItemGroup>
    <PackageReference Update="Microsoft.Azure.Functions.Worker" Version="2.0.0" />
    <PackageReference Update="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.0.0" />
    <PackageReference Update="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.4.0" />
    <PackageReference Update="Azure.Data.Tables" Version="12.9.0" />
    <PackageReference Update="Azure.Storage.Blobs" Version="12.22.2" />
    <PackageReference Update="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Update="Microsoft.Identity.Web" Version="3.2.1" />
    <PackageReference Update="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Update="Microsoft.Graph" Version="5.66.0" />
    <PackageReference Update="Microsoft.ApplicationInsights.WorkerService" Version="2.22.0" />
    <PackageReference Update="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />
    <PackageReference Update="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Update="xunit" Version="2.9.0" />
    <PackageReference Update="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Update="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Update="Moq" Version="4.20.70" />
    <PackageReference Update="FluentAssertions" Version="6.12.1" />
  </ItemGroup>

</Project>
