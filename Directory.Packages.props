<Project>

  <!-- =========================================================
       Central Package Management (CPM) — single source of truth
       for all NuGet package versions across the solution.
       Packages are referenced WITHOUT Version in .csproj files.
       ========================================================= -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Audit only direct dependencies — transitive dependency vulnerabilities
      are surfaced as advisory information but do not break the build.
      We override specific vulnerable transitive packages explicitly below.
    -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Functions isolated worker -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker"                       Version="2.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer"      Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights"   Version="2.0.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService"            Version="2.22.0" />

    <!-- Azure SDK -->
    <PackageVersion Include="Azure.Data.Tables"                   Version="12.9.0" />
    <PackageVersion Include="Azure.Storage.Blobs"                 Version="12.22.2" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets"     Version="4.7.0" />
    <PackageVersion Include="Azure.Identity"                      Version="1.13.1" />

    <!-- Microsoft Identity / Graph -->
    <PackageVersion Include="Microsoft.Identity.Web"              Version="4.13.1" />
    <PackageVersion Include="Microsoft.Identity.Client"           Version="4.86.0" />
    <PackageVersion Include="Microsoft.Graph"                     Version="5.66.0" />

    <!-- ASP.NET / HTTP -->
    <PackageVersion Include="Microsoft.Extensions.Http"           Version="8.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi"        Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"    Version="10.0.0" />

    <!-- Serilog rolling file logging (FR-066) -->
    <PackageVersion Include="Serilog"                             Version="4.1.0" />
    <PackageVersion Include="Serilog.Sinks.File"                  Version="6.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging"          Version="8.0.0" />
    <!-- WMI for hardware metadata collection (FR-001a) -->
    <PackageVersion Include="System.Management"                   Version="9.0.0" />
    <!-- Fluent design for WPF desktop apps -->
    <PackageVersion Include="WPF-UI"                              Version="4.3.0" />

    <!-- Test frameworks -->
    <PackageVersion Include="xunit"                               Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio"           Version="2.8.2" />
    <PackageVersion Include="Moq"                                 Version="4.20.70" />
    <PackageVersion Include="FluentAssertions"                    Version="6.12.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"              Version="17.11.1" />
  </ItemGroup>

</Project>
