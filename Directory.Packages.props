<Project>

  <!-- =========================================================
       Central Package Management (CPM) — single source of truth
       for all NuGet package versions across the solution.
       Packages are referenced WITHOUT Version in .csproj files.
       ========================================================= -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning lets a PackageVersion entry below raise a transitive
      dependency to a patched version without adding a direct PackageReference
      to every project. Used for the security overrides at the end of this file.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      Audit direct AND transitive dependencies so `dotnet restore` surfaces
      NU1901/NU1902/NU1903/NU1904 for anything vulnerable that ships with us.
      These stay warnings (see WarningsNotAsErrors in Directory.Build.props); the
      release workflows fail hard on High/Critical before anything is published.
    -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Functions isolated worker -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker"                       Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk"                   Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer"      Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights"   Version="2.51.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService"            Version="3.1.2" />

    <!-- Azure SDK -->
    <PackageVersion Include="Azure.Data.Tables"                   Version="12.12.0" />
    <PackageVersion Include="Azure.Storage.Blobs"                 Version="12.29.2" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets"     Version="4.11.1" />
    <PackageVersion Include="Azure.Identity"                      Version="1.21.0" />

    <!-- Microsoft Identity / Graph -->
    <PackageVersion Include="Microsoft.Identity.Web"              Version="4.14.2" />
    <PackageVersion Include="Microsoft.Identity.Client"           Version="4.90.0" />
    <PackageVersion Include="Microsoft.Graph"                     Version="6.7.0" />

    <!-- ASP.NET / HTTP -->
    <PackageVersion Include="Microsoft.Extensions.Http"           Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi"        Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"    Version="10.0.12" />

    <!-- Serilog rolling file logging (FR-066) -->
    <PackageVersion Include="Serilog"                             Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File"                  Version="7.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging"          Version="10.0.0" />
    <!-- WMI for hardware metadata collection (FR-001a) -->
    <PackageVersion Include="System.Management"                   Version="10.0.12" />
    <!-- Fluent design for WPF desktop apps -->
    <PackageVersion Include="WPF-UI"                              Version="4.3.0" />
    <!-- Server-side image resizing for uploaded branding logos (FR-038) -->
    <PackageVersion Include="SkiaSharp"                           Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <!-- Pure-managed ISO9660/UDF reading, to extract install.wim/install.esd from uploaded OS image ISOs -->
    <PackageVersion Include="DiscUtils.Iso9660"                   Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Udf"                       Version="0.16.13" />

    <!-- Test frameworks -->
    <PackageVersion Include="xunit"                               Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio"           Version="4.0.0" />
    <PackageVersion Include="Moq"                                 Version="4.20.72" />
    <!-- Not moving FluentAssertions beyond v7 as the license model has changed -->
    <PackageVersion Include="FluentAssertions"                    Version="7.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"              Version="18.10.1" />
  </ItemGroup>

  <!-- =========================================================
       Security overrides for transitive dependencies.
       These packages are not referenced directly; they arrive via
       Microsoft.AspNetCore.OpenApi, Microsoft.Identity.Web and
       Microsoft.Graph. Transitive pinning (enabled above) raises them
       to the first patched version for the advisories listed.
       Remove an entry once the owning package pulls in a fixed version
       on its own, verified with the .slnx package-list vulnerability
       audit, including transitive dependencies.
       ========================================================= -->
  <ItemGroup>
    <!-- GHSA-v5pm-xwqc-g5wc (High) — via Microsoft.AspNetCore.OpenApi -->
    <PackageVersion Include="Microsoft.OpenApi"                   Version="2.12.0" />
    <!-- GHSA-cvvh-rhrc-wg4q, GHSA-g8r8-53c2-pm3f, GHSA-23rf-6693-g89p,
         GHSA-8q5v-6pqq-x66h, GHSA-mmjf-rqrv-855v (High) — via Microsoft.Identity.Web -->
    <PackageVersion Include="System.Security.Cryptography.Xml"    Version="10.0.10" />
    <!-- GHSA-7j59-v9qr-6fq9 (High) — via Microsoft.Graph -->
    <PackageVersion Include="Microsoft.Kiota.Abstractions"        Version="2.0.0" />
  </ItemGroup>

</Project>
