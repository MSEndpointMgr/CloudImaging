<Page x:Class="CloudImaging.MediaBuilder.Views.SignInView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Sign In">
    <!--
        FR-050, FR-052: Welcome screen with branding; Entra ID sign-in required
        before any operation can begin.
        Navigation to OperationSelectionView is blocked until sign-in completes.
    -->
    <Grid>
        <ui:Card HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36">
            <StackPanel Width="420">

                <!-- Logo / branding -->
                <TextBlock Text="☁" FontSize="56"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Cloud Imaging Media Builder"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Generate WinPE boot images and prepare USB media for bare-metal OS imaging."
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,32" />

                <!-- Sign-in button -->
                <ui:Button Content="Sign in with Microsoft"
                           Appearance="Primary"
                           HorizontalAlignment="Center"
                           Width="260" Height="44"
                           FontSize="15"
                           Command="{Binding SignInCommand}"
                           IsEnabled="{Binding CanSignIn}" />

                <!-- Status / error -->
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,14,0,0"
                           Foreground="{Binding HasError, Converter={StaticResource BoolToErrorBrush}}"
                           MaxWidth="380" />
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
