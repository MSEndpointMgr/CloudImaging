<Page x:Class="CloudImaging.MediaBuilder.Views.SignInView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sign In"
      Background="#F8FAFC">
    <!--
        FR-050, FR-052: Welcome screen with branding; Entra ID sign-in required
        before any operation can begin.
        Navigation to OperationSelectionView is blocked until sign-in completes.
    -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo / branding -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="☁️" FontSize="56" HorizontalAlignment="Center" />
            <TextBlock Text="Cloud Imaging Media Builder"
                       FontSize="24" FontWeight="Bold" Foreground="#1E3A5F"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Capability description -->
        <TextBlock Grid.Row="2"
                   TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="14" Foreground="#64748B">
            Generate WinPE boot images and prepare USB media for bare-metal
            OS imaging with the Cloud Imaging system.
        </TextBlock>

        <!-- Sign-in button -->
        <Button Grid.Row="4"
                Content="Sign in with Microsoft"
                Width="260" Height="48"
                FontSize="16"
                Background="#0078D4" Foreground="White"
                BorderThickness="0"
                Command="{Binding SignInCommand}"
                IsEnabled="{Binding CanSignIn}"
                HorizontalAlignment="Center" />

        <!-- Status / error -->
        <TextBlock Grid.Row="6"
                   Text="{Binding StatusMessage}"
                   FontSize="13"
                   Foreground="{Binding HasError, Converter={StaticResource BoolToErrorBrush}}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="440" />
    </Grid>
</Page>
