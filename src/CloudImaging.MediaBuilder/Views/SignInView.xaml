<UserControl x:Class="CloudImaging.MediaBuilder.Views.SignInView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        FR-050, FR-052: Welcome screen with branding; Entra ID sign-in required
        before any operation can begin.
        Navigation to OperationSelectionView is blocked until sign-in completes.
    -->
    <Grid>
        <ui:Card MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36">
            <StackPanel>

                <!-- Logo / branding -->
                <ui:SymbolIcon Symbol="CloudArrowUp24"
                               FontSize="56"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14">
                    <ui:SymbolIcon.Foreground>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.9" />
                    </ui:SymbolIcon.Foreground>
                </ui:SymbolIcon>
                <ui:TextBlock Text="Cloud Imaging Media Builder"
                              FontTypography="Title"
                              TextWrapping="Wrap" TextAlignment="Center"
                              HorizontalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBlock Text="Generate WinPE boot images and prepare USB media for bare-metal OS imaging."
                              FontTypography="Body"
                              Appearance="Secondary"
                              TextWrapping="Wrap" TextAlignment="Center"
                              Margin="0,0,0,32" />

                <!-- Sign-in button (shows an inline spinner while signing in) -->
                <ui:Button Appearance="Primary"
                           HorizontalAlignment="Center"
                           HorizontalContentAlignment="Center"
                           MinWidth="180"
                           Height="44"
                           FontSize="15"
                           Command="{Binding SignInCommand}"
                           IsEnabled="{Binding CanSignIn}"
                           IsDefault="True">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon Symbol="PersonAccounts24" Margin="0,0,8,0" />
                            <TextBlock Text="Sign in" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="22" Height="22"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ui:Button>

                <!-- Status / error (errors only; no transient "signing in" text) -->
                <ui:TextBlock Text="{Binding StatusMessage}"
                              FontTypography="Caption"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              TextWrapping="Wrap"
                              Margin="0,14,0,0"
                              Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                              Foreground="{Binding HasError, Converter={StaticResource BoolToErrorBrush}}"
                              MaxWidth="380" />
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
