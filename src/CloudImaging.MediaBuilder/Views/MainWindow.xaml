<Window x:Class="CloudImaging.MediaBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Imaging Media Builder" Height="600" Width="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <!--
        Host Frame for Media Builder navigation.
        Initial page = SignInView (FR-050: sign-in required before any operation).
    -->
    <Frame x:Name="NavigationFrame"
           NavigationUIVisibility="Hidden"
           Focusable="False" />
</Window>
