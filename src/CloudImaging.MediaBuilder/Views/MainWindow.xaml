<ui:FluentWindow x:Class="CloudImaging.MediaBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cloud Imaging Media Builder" Height="760" Width="1080"
        MinWidth="1000" MinHeight="620"
        Icon="/Assets/taskbar.ico"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <!--
        Content host for Media Builder navigation.
        Initial view = SignInView (FR-050: sign-in required before any operation).
        Fluent title bar + Mica backdrop follow the OS theme (SystemThemeWatcher).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Cloud Imaging Media Builder"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/taskbar.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ContentControl x:Name="ContentHost"
                        Grid.Row="1"
                        Focusable="False"
                        FocusVisualStyle="{x:Null}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</ui:FluentWindow>
