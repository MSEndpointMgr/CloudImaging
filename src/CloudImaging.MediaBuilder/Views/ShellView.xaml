<UserControl x:Class="CloudImaging.MediaBuilder.Views.ShellView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Persistent NavigationView-style app shell shown once the user is signed in.
        Left nav pane (Home / Generate Boot Image / Prepare USB Device) stays visible
        while the right-hand content area swaps between sections (ShellViewModel).

        "Generate Boot Image" is disabled (dimmed, not clickable, with a tooltip) rather
        than hidden or badge-annotated when the Windows ADK is missing (FR-050a) — the
        Home tile explains the requirement inline; the nav item doesn't repeat it.
    -->
    <UserControl.Resources>
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Nav pane -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!--
                    IsEnabled locks the whole nav pane while the hosted section has a long-running
                    operation in flight (WinPE generation, USB write) — see ShellViewModel.CanNavigate.
                    There's no way to resume an abandoned operation after navigating away and back,
                    so this blocks it outright rather than warning about it afterwards.
                -->
                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0"
                            IsEnabled="{Binding CanNavigate}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Navigation is locked while an operation is in progress.">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Home -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoHomeCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,10,0" />
                            <TextBlock Text="Home" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Generate Boot Image — disabled up front when the ADK is missing (FR-050a) or
                         the signed-in user lacks the Administrator role (FR-050b) -->
                    <Border IsEnabled="{Binding IsGenerateBootImageAvailable}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="{Binding GenerateBootImageUnavailableReason}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenerateActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoGenerateCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Power24" Margin="0,0,10,0" />
                            <TextBlock Text="Generate Boot Image" VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGenerateActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Prepare USB Device -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrepareUsbActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoPrepareUsbCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="UsbStick24" Margin="0,0,10,0" />
                            <TextBlock Text="Prepare USB Device" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrepareUsbActive}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Signed-in footer -->
                <Border DockPanel.Dock="Bottom" Margin="8,0,8,12" Padding="8,10,8,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{DynamicResource SystemAccentColorBrush}">
                            <TextBlock Text="{Binding SignedInInitials}"
                                       FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SignedInUserDisplay}"
                                       FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Section content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Breadcrumb: "Home" alone on the Home section, "Home › <Section>" elsewhere -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,16,28,0">
                <TextBlock Text="Home" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsHomeActive, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="›" Margin="6,0" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SectionLabel}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

            <ContentControl Grid.Row="1"
                             Content="{Binding CurrentContent}"
                             Focusable="False"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>

