<UserControl x:Class="CloudImaging.MediaBuilder.Views.OperationResultDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Shared success/failure/cancelled modal for Generate Boot Image and Prepare Storage Device.
        Binds to the host view model's result properties (ShowResultDialog, IsComplete, HasError,
        WasCancelled, SuccessTitle, StatusMessage, ErrorTitle, ErrorMessage, ErrorReference,
        CancelledTitle, CancelledMessage, ResultFilePath/FileName/Folder/FileSymbol and the
        Copy/Open/Dismiss commands). The 4px accent strip signals the outcome; text stays
        selectable; the card caps its height and scrolls so the footer never leaves the window.
    -->
    <UserControl.Resources>
        <Style x:Key="SelectableMessageTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent"
          Visibility="{Binding ShowResultDialog, Converter={StaticResource BoolToVisibility}}">
        <Border MaxWidth="480" MaxHeight="600"
                Margin="24"
                CornerRadius="8"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid MinWidth="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorSuccessBrush}"
                        Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,18,24,0">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SuccessTitle}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                     Text="{Binding StatusMessage, Mode=OneWay}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="20" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorTitle}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                     Text="{Binding ErrorMessage, Mode=OneWay}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding HasErrorReference, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Reference" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                         Text="{Binding ErrorReference, Mode=OneWay}"
                                         FontFamily="Cascadia Mono, Consolas, monospace"
                                         FontSize="12"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CancelledTitle}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                     Text="{Binding CancelledMessage, Mode=OneWay}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Output file row: name, folder, inline copy and open. -->
                        <Border Margin="0,16,0,0"
                                Padding="14,10,8,10"
                                CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasResultFilePath, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding ResultFileSymbol}" FontSize="24" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                             Text="{Binding ResultFileName, Mode=OneWay}"
                                             FontFamily="Cascadia Mono, Consolas, monospace"
                                             FontSize="12"
                                             FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                             Text="{Binding ResultFolder, Mode=OneWay}"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                             Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="2"
                                           Appearance="Transparent"
                                           ToolTip="Copy path"
                                           Padding="6"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Command="{Binding CopyResultPathCommand}">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                                </ui:Button>
                                <ui:Button Grid.Column="3"
                                           Appearance="Transparent"
                                           ToolTip="Open folder"
                                           Padding="6"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Command="{Binding OpenResultFolderCommand}">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                                </ui:Button>
                            </Grid>
                        </Border>
                        <Border Height="18" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Padding="24,16">
                    <Grid>
                        <ui:Button Content="Copy details"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Left"
                                   Padding="10,0"
                                   Height="36"
                                   FontSize="14"
                                   Command="{Binding CopyErrorDetailsCommand}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Close"
                                   Appearance="Primary"
                                   Style="{StaticResource AppButtonStyle}"
                                   HorizontalAlignment="Right"
                                   Command="{Binding DismissResultCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
