<UserControl x:Class="CloudImaging.MediaBuilder.Views.GenerateBootImageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        FR-051a, FR-051b: Source selection (GitHub auto-download or local path) and
        output folder confirmation. No portal upload initiated by this app.
    -->
    <ScrollViewer Margin="40,32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700">

            <TextBlock Text="Generate Boot Image"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,24" />

            <!-- Source selection -->
            <ui:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Client Binaries Source"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,12" />
                    <RadioButton Content="Auto-download latest from GitHub Releases"
                                 IsChecked="{Binding UseGitHubSource}"
                                 GroupName="SourceType" Margin="0,4,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,8"
                                Visibility="{Binding UseGitHubSource, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Status: " Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GitHubStatus}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <RadioButton Content="Use local path (pre-downloaded binaries)"
                                 IsChecked="{Binding UseLocalSource}"
                                 GroupName="SourceType" Margin="0,4,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,4"
                                Visibility="{Binding UseLocalSource, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBox Text="{Binding LocalSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                    Width="320" PlaceholderText="Path to binaries folder" />
                        <ui:Button Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Output folder -->
            <ui:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Output Folder"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                    Width="320" PlaceholderText="Output directory path" />
                        <ui:Button Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Progress -->
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProgressMessage}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" />
                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" />
            </StackPanel>

            <!-- Success -->
            <ui:InfoBar Title="Boot image generated successfully"
                        Message="{Binding OutputWimPath, StringFormat='Output: {0}. Upload the WIM to the Cloud Imaging Portal (Boot Images) to publish it.'}"
                        Severity="Success"
                        IsOpen="{Binding IsComplete}"
                        IsClosable="False"
                        Margin="0,0,0,16" />

            <!-- Error -->
            <ui:InfoBar Title="Generation failed"
                        Message="{Binding ErrorMessage}"
                        Severity="Error"
                        IsOpen="{Binding HasError}"
                        IsClosable="False"
                        Margin="0,0,0,16" />

            <!-- Generate button -->
            <ui:Button Content="Generate Boot Image"
                       Appearance="Primary"
                       Width="220" Height="44" FontSize="15"
                       Command="{Binding GenerateCommand}"
                       IsEnabled="{Binding CanGenerate}"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
