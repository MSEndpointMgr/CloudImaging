<UserControl x:Class="CloudImaging.MediaBuilder.Views.PrepareStorageDeviceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:CloudImaging.MediaBuilder.Views">
    <!--
        FR-053/054/055/056/057: Prepare USB Storage Device workflow.
        Select a published boot image + an eligible USB disk, confirm the destructive
        action, then download to partition to deploy. Only USB/removable/non-system disks
        are eligible; ineligible disks are shown with the blocking reason.

        Layout mirrors GenerateBootImageView's configuration screen: header and the pinned
        action footer are Auto rows outside the ScrollViewer (so only the cards themselves
        scroll and the primary action always stays visible at the bottom of the window instead
        of trailing right after the content with empty space left below it), cards stretch to
        the full available width (no MaxWidth), and the footer is the same bordered
        action-panel + right-aligned button pattern used throughout the app.
    -->
    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Prepare USB Storage Device"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,24" />

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>

            <!-- Published boot image -->
            <ui:Card Margin="0,0,0,16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="Published Boot Image"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Boot images published from the Cloud Imaging Portal (Boot Images). The latest published version is selected automatically. Pick an older one here to roll back to it, or click Refresh to re-check for a newly published boot image."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Row="1" Grid.Column="0"
                              ItemsSource="{Binding BootImages}"
                              SelectedItem="{Binding SelectedBootImage}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding IsBootImageSelectionEnabled}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" />

                    <ui:Button Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource AppButtonStyle}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="86"
                               HorizontalContentAlignment="Center"
                               Command="{Binding RefreshCommand}">
                        <Grid>
                            <TextBlock Text="Refresh"
                                       Visibility="{Binding IsRefreshingBootImages, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="16" Height="16"
                                             Visibility="{Binding IsRefreshingBootImages, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <!-- Target: USB device or ISO file -->
            <ui:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Target"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Choose whether to write the boot image directly to a USB storage device, or package it as a bootable ISO file you can attach to a virtual machine's DVD drive (or burn to physical media) instead."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <RadioButton Content="USB Storage Device"
                                 IsChecked="{Binding PrepareAsUsb}"
                                 IsEnabled="{Binding IsFormEnabled}"
                                 Margin="0,0,0,8" />
                    <RadioButton Content="ISO File (boot a virtual machine or physical media)"
                                 IsChecked="{Binding PrepareAsIso}"
                                 IsEnabled="{Binding IsIsoGenerationAvailable}" />
                    <TextBlock Text="Generating an ISO requires the Windows ADK with the WinPE add-on installed on this workstation."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="24,4,0,0"
                               Visibility="{Binding IsIsoGenerationAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </ui:Card>

            <!-- USB device: shown immediately after the Target choice, above the optional Location
                 card below, so the required disk selection is never pushed down by optional
                 configuration. -->
            <ui:Card Margin="0,0,0,16" Padding="20"
                     Visibility="{Binding PrepareAsUsb, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="USB Device"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Only removable USB disks that aren't the machine's system disk are eligible. Internal and fixed disks are hidden from this list entirely to prevent an accidental wipe. The list updates automatically when you plug in or remove a USB device."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <ComboBox ItemsSource="{Binding Disks}"
                              SelectedItem="{Binding SelectedDisk}"
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding IsDiskSelectionEnabled}"
                              HorizontalAlignment="Stretch" />

                    <ui:InfoBar Title="Disk not eligible"
                                Message="{Binding ValidationMessage}"
                                Severity="Error"
                                IsOpen="{Binding HasValidationMessage}"
                                IsClosable="False"
                                Margin="0,12,0,0" />

                    <ui:InfoBar Title="Smaller than recommended"
                                Message="{Binding DiskWarning}"
                                Severity="Warning"
                                IsOpen="{Binding HasDiskWarning}"
                                IsClosable="False"
                                Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- Location (Location Labels feature): written into the manifest on USB media and on an ISO alike. -->
            <ui:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Location (optional)"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="The site this boot media will be used at. Devices booted from it are labeled with this location in the portal, and Autopilot group tag templates are built from it."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsFormEnabled}"
                                  HorizontalAlignment="Stretch" />

                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   ToolTip="Clear selected location"
                                   Margin="8,0,0,0"
                                   Padding="8"
                                   Command="{Binding ClearLocationCommand}">
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Wi-Fi networks: read-only; the portal is the only place networks are edited. Windows PE images have no Wi-Fi, so the card is hidden for them. -->
            <ui:Card Margin="0,0,0,16" Padding="20"
                     Visibility="{Binding ShowWifiCard, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Wi-Fi Networks"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding WifiCardDescription}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WifiNetworks}"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding HasWifiNetworks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Wifi124" FontSize="16"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Ssid}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Driver sets: optional; copied to the CACHE partition so devices of these models do not download them. -->
            <ui:Card Margin="0,0,0,16" Padding="20"
                     Visibility="{Binding ShowDriverSetsCard, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Driver sets"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Copies drivers to the USB drive, so devices of these models do not download them."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DriverSets.EmptyText}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding DriverSets.HasEmptyText, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DriverSets.Groups}"
                                  IsEnabled="{Binding IsFormEnabled}"
                                  Margin="0,8,0,0"
                                  Visibility="{Binding DriverSets.HasSets, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding VendorName}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,2" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding ModelName}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                        <TextBlock Text="{Binding ModelName}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ReleaseName}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource BodyTextBlockStyle}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DriverSets.Summary}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <ui:InfoBar Title="Less space for OS images"
                                Message="Less than 20 GB stays free for OS images. Larger images are then downloaded every time instead of cached."
                                Severity="Warning"
                                IsOpen="{Binding DriverSets.ShowLowSpaceWarning}"
                                IsClosable="False"
                                Margin="0,12,0,0" />
                    <ui:InfoBar Title="Driver sets do not fit"
                                Message="{Binding DriverSetsDoNotFitMessage}"
                                Severity="Error"
                                IsOpen="{Binding DriverSets.DoesNotFit}"
                                IsClosable="False"
                                Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- Destructive confirmation -->
            <ui:Card Margin="0,0,0,16" Padding="16,14"
                     Visibility="{Binding PrepareAsUsb, Converter={StaticResource BoolToVisibility}}">
                <CheckBox IsChecked="{Binding ConfirmErase}"
                          IsEnabled="{Binding IsFormEnabled}"
                          Content="I understand that ALL data on the selected USB device will be permanently erased." />
            </ui:Card>

            <!-- ISO output path -->
            <ui:Card Margin="0,0,0,16" Padding="20"
                     Visibility="{Binding PrepareAsIso, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Output ISO File"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Choose where to save the generated ISO file."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding IsoOutputPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding IsFormEnabled}" />

                        <ui:Button Grid.Column="1" Content="Browse…"
                                   Style="{StaticResource AppButtonStyle}"
                                   Margin="8,0,0,0"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Command="{Binding BrowseIsoOutputCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Progress -->
            <ui:Card Margin="0,0,0,16" Padding="20"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding ProgressMessage}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
        </ScrollViewer>

        <!--
            Pinned footer: same pattern as GenerateBootImageView's action panel: its own
            background/border so it reads as a fixed action panel rather than more scrollable
            content, a short caption in the Auto-remaining column explaining what the button
            does, and the button right-aligned in its own column. Holds Cancel while a
            preparation is in progress, Prepare USB Device otherwise: fields stay editable
            after a failure/cancellation, so the same button simply retries when clicked again,
            with no separate "Back"/"Retry" pair needed (matching the Generate view's
            configuration screen, which likewise relies on the sidebar nav rather than an
            in-page Back button before an operation has started).
        -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="20,16"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Cancel stops the preparation and cleans up the downloaded boot image. Data already written to the USB device may be left incomplete."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <ui:Button Grid.Column="1"
                               Appearance="Secondary"
                               Style="{StaticResource AppButtonStyle}"
                               Command="{Binding CancelCommand}"
                               HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <Grid Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding PrepareDescription}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <ui:Button Grid.Column="1" Content="{Binding PrepareButtonLabel}"
                               Appearance="Primary"
                               Style="{StaticResource AppButtonStyle}"
                               Command="{Binding PrepareCommand}"
                               IsEnabled="{Binding CanPrepare}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <!--
            Result modal over the whole page, shown for any terminal outcome until dismissed.
            Closing it resets the workflow so the next USB device can be prepared immediately.
        -->
        <views:OperationResultDialog Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</UserControl>
