<Page x:Class="CloudImaging.MediaBuilder.Views.OperationSelectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Select Operation"
      Background="#F8FAFC">
    <!--
        FR-051: Media Builder OperationSelectionView.
        Two operation cards: Generate Boot Image and Prepare USB.
        User selects one then clicks Continue.
    -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select an Operation"
                   FontSize="28" FontWeight="Bold" Foreground="#1E3A5F"
                   HorizontalAlignment="Center" />

        <!-- Operation cards -->
        <UniformGrid Grid.Row="2" Columns="2" HorizontalAlignment="Center">

            <!-- Generate Boot Image -->
            <Border Margin="8" Padding="24" CornerRadius="8"
                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="GenerateBootImage">
                                <Setter Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="GenerateBootImage" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="💿" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Generate Boot Image" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Build a WinPE boot image with the Cloud Imaging Client embedded."
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Prepare USB -->
            <Border Margin="8" Padding="24" CornerRadius="8"
                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="PrepareUSB">
                                <Setter Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="PrepareUSB" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="🖫" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Prepare USB" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Download a boot image from the portal and write it to USB media."
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Button Grid.Row="4"
                Content="Continue →"
                Width="200" Height="44" FontSize="16"
                Background="#2563EB" Foreground="White" BorderThickness="0"
                Command="{Binding ContinueCommand}"
                IsEnabled="{Binding CanContinue}"
                HorizontalAlignment="Center" />
    </Grid>
</Page>
