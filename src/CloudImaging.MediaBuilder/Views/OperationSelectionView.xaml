<UserControl x:Class="CloudImaging.MediaBuilder.Views.OperationSelectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        FR-051: Media Builder OperationSelectionView (the shell's "Home" content).
        Two operation tiles: Generate Boot Image and Prepare USB Device. A single tap
        navigates directly to the section (FR-050a: Generate Boot Image is disabled up
        front — not just warned about after selection — when the ADK is missing).
    -->
    <Grid Margin="28,16,28,28" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Cloud Imaging Media Builder"
                       Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Create WinPE boot images and prepare USB devices for cloud-driven Windows imaging."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Operation tiles -->
        <UniformGrid Grid.Row="2" Columns="2">

            <!-- Generate Boot Image — disabled up front when the ADK is missing (FR-050a) or the
                 signed-in user lacks the Administrator role (FR-050b) -->
            <Border Margin="0,0,14,0" Padding="20" CornerRadius="8" Cursor="Hand"
                    IsEnabled="{Binding IsGenerateBootImageAvailable}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="{Binding GenerateBootImageUnavailableReason}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding NavigateCommand}"
                                  CommandParameter="GenerateBootImage" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Border CornerRadius="8" Background="{DynamicResource SystemAccentColorBrush}" Opacity="0.15" />
                        <ui:SymbolIcon Symbol="Power24" FontSize="22"
                                       Foreground="{DynamicResource SystemAccentColorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Generate Boot Image"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Build a WinPE boot image with the Cloud Imaging Client embedded, drivers injected, and the boot-media certificate stamped in."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="⚠ Requires the Windows ADK (not installed)"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Margin="0,6,0,0"
                               Visibility="{Binding IsBlockedByMissingAdk, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Requires the Administrator role"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Margin="0,6,0,0"
                               Visibility="{Binding IsRestrictedByRole, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Prepare USB -->
            <Border Margin="14,0,0,0" Padding="20" CornerRadius="8" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding NavigateCommand}"
                                  CommandParameter="PrepareUSB" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Border CornerRadius="8" Background="{DynamicResource SystemAccentColorBrush}" Opacity="0.15" />
                        <ui:SymbolIcon Symbol="UsbStick24" FontSize="22"
                                       Foreground="{DynamicResource SystemAccentColorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Prepare USB Device"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Download a published boot image from the portal (or use the local cache) and write it to a USB device."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- FR-050a: ADK prerequisite banner, shown whenever the ADK is the reason Generate Boot Image is unavailable -->
        <Border Grid.Row="4" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                Visibility="{Binding IsBlockedByMissingAdk, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Warning24"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Windows ADK required. " FontWeight="SemiBold" /><Run Text="Install the ADK and WinPE add-on, then relaunch."
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows-hardware/get-started/adk-install"
                                   RequestNavigate="OnHyperlinkRequestNavigate"
                                   Foreground="{DynamicResource SystemAccentColorBrush}">Download the ADK and WinPE add-on</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FR-050b: Administrator-role banner, shown when the signed-in user's role is the reason Generate Boot Image is unavailable -->
        <Border Grid.Row="4" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                Visibility="{Binding IsRestrictedByRole, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="LockClosed24"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Administrator role required. " FontWeight="SemiBold" /><Run Text="Generating boot images is restricted to the Administrator role. Ask your Cloud Imaging administrator to grant it if you need access."
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>