<UserControl x:Class="CloudImaging.MediaBuilder.Views.OperationSelectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        FR-051: Media Builder OperationSelectionView.
        Two operation cards: Generate Boot Image and Prepare USB.
        User selects one then clicks Continue.
    -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select an Operation"
                   Style="{StaticResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />

        <!-- Operation cards -->
        <UniformGrid Grid.Row="2" Columns="2">

            <!-- Generate Boot Image -->
            <Border Margin="8" Padding="24" CornerRadius="8" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="GenerateBootImage">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="GenerateBootImage" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="💿" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Generate Boot Image"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Build a WinPE boot image with the Cloud Imaging Client embedded."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Prepare USB -->
            <Border Margin="8" Padding="24" CornerRadius="8" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="PrepareUSB">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="PrepareUSB" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="🖫" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Prepare USB"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Download a boot image from the portal and write it to USB media."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="4">
            <!-- FR-050a: ADK prerequisite warning shown before navigating to Generate Boot Image -->
            <Border Margin="8,0,8,16" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    Visibility="{Binding ShowAdkWarning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Warning24"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Windows ADK required — " FontWeight="SemiBold" /><Run Text="install the ADK and WinPE add-on, then relaunch."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows-hardware/get-started/adk-install"
                                       RequestNavigate="OnHyperlinkRequestNavigate"
                                       Foreground="{DynamicResource SystemAccentColorBrush}">Download the ADK and WinPE add-on</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <ui:Button Content="Continue"
                       Appearance="Primary"
                       Width="200" Height="44" FontSize="15"
                       Command="{Binding ContinueCommand}"
                       IsEnabled="{Binding CanContinue}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>