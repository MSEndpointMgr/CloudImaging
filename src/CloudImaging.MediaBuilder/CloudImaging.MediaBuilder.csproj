<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF requires net10.0-windows -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>CloudImaging.MediaBuilder</RootNamespace>
    <!-- Technician workstation app: Entra ID sign-in via MSAL desktop (FR-052) -->
    <!--
      Disables the WPF design-time temp project to prevent LoggerMessage source-generator
      code from being compiled twice (main project + _wpftmp.csproj duplicate members).
    -->
    <UseWpfTempProject>false</UseWpfTempProject>
    <!-- App/window icon shown in the taskbar, Alt+Tab, and the exe's own file icon. -->
    <ApplicationIcon>Assets\taskbar.ico</ApplicationIcon>
    <!--
      Only the English satellite resources for the .NET runtime/WPF itself are needed (the
      Media Builder's own UI has no localization). Without this, a self-contained publish
      bundles a cs/, de/, es/, fr/, it/, ja/, ko/, pl/, pt-BR/, ru/, tr/, zh-Hans/, zh-Hant/
      folder full of runtime *.resources.dll files that are never loaded.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    DEV SIMULATION MODE (developer-only "step through every view" navigator).
    The DEV_SIMULATION constant is defined ONLY for Debug builds, so every piece of
    dev-mode code (guarded by #if DEV_SIMULATION) is physically excluded from the
    compiled binary in Release. Released artifacts are always published with
    `-c Release` (see .github/workflows/release.yml), so dev mode can never surface
    in a shipped application.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEV_SIMULATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <!-- MSAL Desktop (Entra ID interactive sign-in) -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <!-- Fluent UI design library -->
    <PackageReference Include="WPF-UI" />
    <!-- WMI for USB disk enumeration (FR-054) -->
    <PackageReference Include="System.Management" />
    <!-- Serilog rolling file logging: max 10 MB per file, 5 retained (FR-066) -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudImaging.Contracts\CloudImaging.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Git-ignored local dev overlay (real Entra/Operator API values). Copied only when present. -->
    <Content Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as WPF resources so they can be referenced from XAML (Window.Icon, TitleBar.Icon) via a pack URI. -->
    <Resource Include="Assets\taskbar.ico" />
  </ItemGroup>

</Project>
