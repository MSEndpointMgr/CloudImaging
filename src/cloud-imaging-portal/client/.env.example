# Cloud Imaging Portal: Frontend environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.

# Entra ID app registration (shared, created manually by the administrator)
VITE_ENTRA_CLIENT_ID=your-entra-client-id-here
VITE_ENTRA_TENANT_ID=your-entra-tenant-id-here
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Portal backend base URL (forwarded via Vite proxy in dev; no trailing slash)
VITE_API_BASE_URL=http://localhost:3000
