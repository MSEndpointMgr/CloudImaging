# Cloud Imaging Portal — Backend environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.

# Server
PORT=3000
NODE_ENV=development

# Entra ID — shared app registration (same as client)
ENTRA_CLIENT_ID=your-entra-client-id-here
ENTRA_TENANT_ID=your-entra-tenant-id-here
ENTRA_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Operator API (Azure Functions URL)
OPERATOR_API_BASE_URL=https://your-prefix-dev-func-operator.azurewebsites.net

# Application Insights (server-side; injected by deployment — set locally for dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
