# Cloud Imaging Portal — Backend environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.

# Server
PORT=3000
NODE_ENV=development

# Entra ID — shared app registration (same as client)
ENTRA_CLIENT_ID=your-entra-client-id-here
ENTRA_TENANT_ID=your-entra-tenant-id-here
ENTRA_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Operator API (Azure Functions URL)
OPERATOR_API_BASE_URL=https://your-prefix-dev-ci-func-operator.azurewebsites.net

# Operator API scope for the portal backend's managed-identity token (backend-for-frontend).
# Use the Operator API app registration's App ID URI + /.default.
# The portal identity must hold the CloudImaging.PortalAccess app role on this registration.
OPERATOR_API_SCOPE=api://your-operator-api-client-id/.default

# User-assigned managed identity client ID used to acquire the Operator API token.
# In Azure this is injected by deployment; leave unset locally to fall back to your az login.
# AZURE_CLIENT_ID=your-portal-msi-client-id

# Application Insights (server-side; injected by deployment — set locally for dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
