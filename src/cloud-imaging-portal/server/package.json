{
  "name": "cloud-imaging-portal-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^5.0.0",
    "@azure/msal-node": "^2.16.1",
    "applicationinsights": "^3.3.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3",
    "@vitest/coverage-v8": "^2.1.3",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
