<Application x:Class="CloudImaging.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Dark is the startup default so WinPE (where the OS theme cannot be
                    read) renders dark instead of flashing white. On a real desktop
                    MainWindow applies the actual OS theme as soon as it loads.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
                Renders a status message as a read-only, selectable/copyable TextBox instead of
                relying on ui:InfoBar's own (plain, non-selectable) Message property or a plain
                TextBlock — so technicians can select/copy error details and support reference
                codes straight out of the Results/Progress screens. Matches the accent-strip
                result-dialog design used across the Media Builder app.
            -->
            <Style x:Key="SelectableMessageTextBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="True" />
                <Setter Property="IsUndoEnabled" Value="False" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Cursor" Value="IBeam" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
