<Application x:Class="CloudImaging.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Dark is the startup default so WinPE (where the OS theme cannot be
                    read) renders dark instead of flashing white. On a real desktop
                    MainWindow applies the actual OS theme as soon as it loads.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- ClientFooter buttons: quiet tools on the left, normal-size actions on the right. -->
            <Style x:Key="FooterToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style x:Key="FooterActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <!--
                Footer bar every screen shares: Header = the screen's tools (left of View Log),
                Content = the screen's actions (right-aligned, main action last). A style rather than
                a UserControl: a local type in page XAML forces the _wpftmp markup project, which
                Directory.Build.targets strips of the services the views depend on.
            -->
            <Style x:Key="ClientFooterStyle" TargetType="HeaderedContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <Border Height="64" Padding="16,0"
                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ContentPresenter ContentSource="Header" />
                                        <ui:Button Content="View Log"
                                                   Style="{StaticResource FooterToolButtonStyle}"
                                                   Icon="{ui:SymbolIcon DocumentText24}"
                                                   Click="FooterViewLogButton_Click" />
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Renders a status message as a read-only, selectable/copyable TextBox instead of
                relying on ui:InfoBar's own (plain, non-selectable) Message property or a plain
                TextBlock — so technicians can select/copy error details and support reference
                codes straight out of the Results/Progress screens. Matches the accent-strip
                result-dialog design used across the Media Builder app.
            -->
            <Style x:Key="SelectableMessageTextBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="True" />
                <Setter Property="IsUndoEnabled" Value="False" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Cursor" Value="IBeam" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
