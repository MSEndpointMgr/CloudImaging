<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF requires net10.0-windows; overrides Directory.Build.props net10.0 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>CloudImaging.Client</RootNamespace>
    <!-- WinPE runtime: no external APM, no Entra ID sign-in (FR-066, FR-071) -->
    <!--
      Disables the WPF design-time temp project to prevent LoggerMessage source-generator
      code from being compiled twice (main project + _wpftmp.csproj duplicate members).
    -->
    <UseWpfTempProject>false</UseWpfTempProject>
    <!--
      Only the English satellite resources for the .NET runtime/WPF itself are needed (the
      Client's own UI has no localization). Without this, a self-contained publish bundles a
      cs/, de/, es/, fr/, it/, ja/, ko/, pl/, pt-BR/, ru/, tr/, zh-Hans/, zh-Hant/ folder full of
      runtime *.resources.dll files that are never loaded.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      No app.manifest previously existed, so Windows treated the process as DPI-unaware and
      DPI-virtualized (bitmap-stretched) the whole window on any WinPE display not running at
      exactly 96 DPI/100% scaling — the actual cause of controls/text looking "pixelated" rather
      than merely un-hinted. app.manifest declares PerMonitorV2 DPI awareness instead.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    DEV SIMULATION MODE (developer-only "step through every view" navigator).
    The DEV_SIMULATION constant is defined ONLY for Debug builds, so every piece of
    dev-mode code (guarded by #if DEV_SIMULATION) is physically excluded from the
    compiled binary in Release. Released artifacts are always published with
    `-c Release` (see .github/workflows/release-client.yml), so dev mode can never surface
    in a shipped application. Mirrors the CloudImaging.MediaBuilder pattern.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEV_SIMULATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudImaging.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Fluent UI design library -->
    <PackageReference Include="WPF-UI" />
    <!-- WMI for hardware metadata collection (FR-001a) -->
    <PackageReference Include="System.Management" />
    <!-- Serilog rolling file logging: max 10 MB per file, 5 retained (FR-066) -->
    <!-- Git-ignored local dev overlay (real Device Gateway base URL). Copied only when present. -->
    <Content Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <!-- MSAL for token caching is NOT used — the Client uses mTLS cert auth only -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudImaging.Contracts\CloudImaging.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
