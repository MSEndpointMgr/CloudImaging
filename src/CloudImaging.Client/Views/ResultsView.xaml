<Page x:Class="CloudImaging.Client.Views.ResultsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Results">
    <!-- FR-025, FR-026: Three terminal outcomes — Success, Failure, NotAuthorized -->
    <Grid>
        <ui:Card HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,40">
            <StackPanel Width="560">

                <!-- SUCCESS -->
                <StackPanel Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="64" FontWeight="Bold"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Imaging Complete"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="The operating system has been successfully applied."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <!-- FAILURE -->
                <StackPanel Visibility="{Binding IsFailure, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="✕" FontSize="64" FontWeight="Bold"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Imaging Failed"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <ui:InfoBar Title="{Binding SupportReferenceCode, StringFormat='Support Reference: {0}'}"
                                Message="{Binding ErrorDetail}"
                                Severity="Error"
                                IsOpen="True"
                                IsClosable="False"
                                Margin="0,16,0,0" />
                    <TextBlock Text="Contact your IT administrator with the support reference code above."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <ui:Button Content="Retry"
                               Appearance="Danger"
                               Width="160"
                               Command="{Binding RetryCommand}"
                               HorizontalAlignment="Center" Margin="0,24,0,0" />
                </StackPanel>

                <!-- NOT AUTHORIZED -->
                <StackPanel Visibility="{Binding IsNotAuthorized, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="⊘" FontSize="64" FontWeight="Bold"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Device Not Authorized"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding DeviceSerialNumber, StringFormat='Serial: {0}'}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <ui:InfoBar Title="Enrollment required"
                                Message="This device is not enrolled in Windows Autopilot or the Intune Corporate Device Identifiers list. Enroll the device in your organization's device management system before imaging."
                                Severity="Warning"
                                IsOpen="True"
                                IsClosable="False"
                                Margin="0,16,0,0" />
                    <!-- FR-007b/FR-026: Exit/Close is the only available action on this outcome (no Retry). -->
                    <ui:Button Content="Exit"
                               Appearance="Secondary"
                               Width="160"
                               Command="{Binding ExitCommand}"
                               HorizontalAlignment="Center" Margin="0,24,0,0" />
                </StackPanel>

            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
