<Page x:Class="CloudImaging.Client.Views.ResultsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Results">
    <!--
        FR-021, FR-025, FR-026: Four terminal outcomes — Success, Failure, NotAuthorized, Expired.

        Accent-strip design (matches the Media Builder result dialog): a thin colour strip
        along the card's top edge signals the outcome instead of a big Unicode glyph, and any
        error/enrollment detail is shown as plain, borderless, selectable text (TextBox styled
        via SelectableMessageTextBoxStyle) instead of inside a boxed ui:InfoBar — so technicians
        can still select/copy failure details and support reference codes straight off screen.
    -->
    <Grid>
        <Border CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- The blocked card is wider so a requirement name and value fit on one line. -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="MaxWidth" Value="640" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotAuthorized}" Value="True">
                            <Setter Property="MaxWidth" Value="680" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status accent strip — states are mutually exclusive, so only one is ever visible -->
                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorSuccessBrush}"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding IsFailure, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding IsNotAuthorized, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Row="0" CornerRadius="8,8,0,0"
                        Background="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding IsExpired, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Row="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Width" Value="560" />
                            <Setter Property="Margin" Value="48,36,48,40" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotAuthorized}" Value="True">
                                    <Setter Property="Width" Value="606" />
                                    <Setter Property="Margin" Value="36,28,36,28" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- SUCCESS -->
                    <StackPanel Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="Imaging Complete"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="The operating system has been successfully applied."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />

                        <!-- Auto-restart countdown: drains from 100% to 0% over 10 seconds,
                             then the device restarts automatically (see ResultsViewModel).
                             Mode=OneWay is required: ProgressBar.Value binds TwoWay by default,
                             but RestartCountdownPercent is a read-only computed property. -->
                        <ProgressBar Value="{Binding RestartCountdownPercent, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="6"
                                     Margin="0,24,0,0" />
                        <TextBlock Text="{Binding RestartCountdownSecondsRemaining, StringFormat='Restarting in {0}s…'}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- FAILURE -->
                    <StackPanel Visibility="{Binding IsFailure, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="48"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="Imaging Failed"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding SupportReferenceCode, StringFormat='Error reference: {0}'}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <!--
                            ErrorDetail is pre-truncated by ImagingWorkflowViewModel.FailAsync
                            before it ever reaches this binding (see BuildOnScreenErrorDetail):
                            a failed external tool (diskpart/bcdboot/reagentc) can embed its full
                            console transcript in the underlying exception, but FR-002b forbids a
                            ScrollViewer here, so the full detail is only ever in the rolling log
                            (openable via "View Log") and this box always shows a short summary.
                        -->
                        <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                 Text="{Binding ErrorDetail, Mode=OneWay}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextAlignment="Center"
                                 Margin="0,8,0,0" />
                        <ui:Button Content="Retry"
                                   Appearance="Danger"
                                   Width="160"
                                   Command="{Binding RetryCommand}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0" />
                    </StackPanel>

                    <!-- EXPIRED — session never coupled before the passcode/inactivity window
                         elapsed (FR-021). Warning-toned like NotAuthorized (not red/error, since
                         this is a benign timeout), but still offers Retry like Failure. -->
                    <StackPanel Visibility="{Binding IsExpired, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="48"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="Session Expired"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="No operator entered the passcode before it timed out. Start again to request a new one."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <ui:Button Content="Retry"
                                   Appearance="Secondary"
                                   Width="160"
                                   Command="{Binding RetryCommand}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0" />
                    </StackPanel>

                    <!-- NOT AUTHORIZED: blocked by pre-flight checks. One line per switched-on
                         requirement; fix hints are written to the log, opened with View Log. -->
                    <StackPanel Visibility="{Binding IsNotAuthorized, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24" FontSize="36"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Device Blocked" Style="{StaticResource TitleTextBlockStyle}" />
                                <WrapPanel>
                                    <TextBlock Text="{Binding DeviceSerialNumber, StringFormat='Serial: {0}'}"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,20,0" />
                                    <TextBlock Text="{Binding SessionId, StringFormat='Session: {0}'}"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Per-check results -->
                        <StackPanel Visibility="{Binding HasBlockedRequirements, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BlockedSummary}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,14,0,0" />
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,16,0,0" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding BlockedRequirements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Met}" Value="False">
                                                                <Setter Property="Background" Value="#12FF99A4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="202" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon FontSize="16" VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Met}" Value="False">
                                                                        <Setter Property="Symbol" Value="DismissCircle24" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Backends without per-check results only ever blocked on enrollment. -->
                        <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                                 Visibility="{Binding HasNoBlockedRequirements, Converter={StaticResource BoolToVisibility}}"
                                 Text="This device is not enrolled in Windows Autopilot or the Intune Corporate Device Identifiers list. Enroll the device in your organization's device management system before imaging."
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Margin="0,14,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <ui:Button Content="View Log"
                                       Appearance="Secondary"
                                       MinWidth="120"
                                       Icon="{ui:SymbolIcon DocumentText24}"
                                       Click="ViewLogButton_Click" />
                            <ui:Button Content="Try again"
                                       Appearance="Secondary"
                                       MinWidth="120" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Command="{Binding TryAgainCommand}" />
                            <ui:Button Content="Exit"
                                       Appearance="Secondary"
                                       MinWidth="120" Margin="8,0,0,0"
                                       Command="{Binding ExitCommand}" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
