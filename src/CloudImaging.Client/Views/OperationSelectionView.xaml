<Page x:Class="CloudImaging.Client.Views.OperationSelectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Select Operation">
    <!--
        FR-001: Device boot into WinPE, operator selects Imaging or Decommissioning.
        Imaging selection triggers silent hardware metadata collection before registration.
        Decommissioning is not implemented yet; its card is collapsed below rather than
        removed, so it can be re-enabled for a future release without re-authoring the view.
    -->
    <Grid>
        <!-- Own row for the footer, so a tall banner can never push content onto it. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: optional portal branding logo + title + description, centered as a group -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <!--
                Branding logo embedded in the boot image (branding\logo.png next to the exe,
                configured through the portal). Collapsed by default; the code-behind makes it
                visible only when a logo is present.
            -->
            <Image x:Name="BrandingLogo"
                   Width="72" Height="72"
                   Margin="0,0,20,0"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed" />

            <!--
                Default vector logo shown whenever no portal-provided branding\logo.png is
                configured for this boot image, so the header never renders with a blank gap
                where a logo would otherwise go.
            -->
            <ui:SymbolIcon x:Name="BrandingLogoFallback"
                           Symbol="CloudArrowDown24"
                           FontSize="56"
                           Margin="0,0,20,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Visibility="Collapsed" />

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cloud Imaging"
                           Style="{StaticResource TitleLargeTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select an operation below to get started."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>

        <!--
            Operation cards. One row, fixed card height: a UniformGrid without Rows lays out
            square (two cards became 2x2, an empty card-tall row), and a card whose description
            wraps would grow the row. Either moved the header and Continue when a card appeared.
        -->
        <UniformGrid Grid.Row="2" Rows="1" HorizontalAlignment="Center">
            <!-- Imaging card -->
            <Border Width="340" Height="200" Margin="8" Padding="24" CornerRadius="8" Cursor="Hand"
                    IsEnabled="{Binding IsImagingSelectable}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="Imaging">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="Imaging" />
                </Border.InputBindings>
                <StackPanel VerticalAlignment="Center">
                    <!-- Imaging = pull a fresh OS image from the cloud down onto the local disk -->
                    <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Imaging"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ImagingCardDescription}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Register with Autopilot: only on boot media built with the hash tooling; never touches the disk -->
            <Border Width="340" Height="200" Margin="8" Padding="24" CornerRadius="8" Cursor="Hand"
                    Visibility="{Binding IsAutopilotOptionVisible, Converter={StaticResource BoolToVisibility}}"
                    IsEnabled="{Binding IsAutopilotSelectable}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="Autopilot">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="Autopilot" />
                </Border.InputBindings>
                <StackPanel VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Register with Autopilot"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding AutopilotCardDescription}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Decommissioning card: not implemented, hidden until a future release -->
            <Border Visibility="Collapsed" Width="340" Height="200" Margin="8" Padding="24" CornerRadius="8" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedOperation}" Value="Decommissioning">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding SelectOperationCommand}"
                                  CommandParameter="Decommissioning" />
                </Border.InputBindings>
                <StackPanel>
                    <ui:SymbolIcon Symbol="Delete24" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Decommissioning"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Securely wipe this device for retirement."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Status / error -->
        <!--
            One message card for every network message: the blocking problem, Check again in progress,
            and short-lived successes. Hidden rather than collapsed, so the cards above never move.
        -->
        <Grid Grid.Row="4">
        <Border Width="696" MinHeight="68" Padding="16,12" CornerRadius="6" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConnectivityMessage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsConnectivityError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsConnectivityWarning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="20"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding IsConnectivityError, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon Symbol="Warning24" FontSize="20"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding IsConnectivityWarning, Converter={StaticResource BoolToVisibility}}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18"
                                     Visibility="{Binding IsConnectivityProgress, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding IsConnectivitySuccess, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectivityHeading}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding ConnectivityDetail}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:Button Content="Connect to Wi-Fi" Appearance="Secondary"
                               Icon="{ui:SymbolIcon Wifi124}"
                               Click="ConnectWifiButton_Click"
                               Visibility="{Binding ShowBannerWifiAction, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Check again" Appearance="Secondary" Margin="8,0,0,0"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding RecheckCommand}"
                               Visibility="{Binding ShowBannerRecheck, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:InfoBar Title="Waiting for an IP address"
                    Message="Registration starts once a network adapter is up."
                    Severity="Informational"
                    IsOpen="{Binding IsWaitingForNetwork}"
                    IsClosable="False" />

        <ui:InfoBar Title="Error"
                    Message="{Binding StatusMessage}"
                    Severity="Error"
                    IsOpen="{Binding HasError}"
                    IsClosable="False" />
        </Grid>
        </Grid>

        <!-- Support tools are deliberately low-key so they never compete with Continue. -->
        <HeaderedContentControl Grid.Row="1" Style="{StaticResource ClientFooterStyle}">
            <HeaderedContentControl.Header>
                <StackPanel Orientation="Horizontal">
                    <!-- The connection in use; opens the Network panel. Replaces the old Connect to Wi-Fi button. -->
                    <ui:Button x:Name="NetworkButton"
                               Style="{StaticResource FooterToolButtonStyle}"
                               AutomationProperties.Name="Network"
                               Click="NetworkButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding NetworkSymbol}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetworkLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}"
                                     Visibility="{Binding IsNetworkMissing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <Popup x:Name="NetworkPopup"
                           PlacementTarget="{Binding ElementName=NetworkButton}"
                           Placement="Top" VerticalOffset="-8"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Width="380" Padding="16,12,16,14" CornerRadius="8"
                                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Network" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ItemsControl ItemsSource="{Binding NetworkRows}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <!-- Tint under the label: an Opacity on the pill itself would fade the text too. -->
                                                        <Grid Margin="8,0,0,0" VerticalAlignment="Center"
                                                              Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                            <Border CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="7,0" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ui:Button Content="Connect to Wi-Fi" Appearance="Secondary" Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon Wifi124}"
                                               Click="ConnectWifiButton_Click"
                                               Visibility="{Binding IsWifiAvailable, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Content="Check again" Appearance="Secondary"
                                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                                               Click="PanelCheckAgainButton_Click"
                                               Visibility="{Binding CanRecheck, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ui:Button x:Name="CommandPromptButton"
                               Content="Command Prompt"
                               Style="{StaticResource FooterToolButtonStyle}"
                               Icon="{ui:SymbolIcon WindowConsole20}"
                               Command="{Binding LaunchCommandPromptCommand}"
                               Visibility="{Binding IsCommandPromptAvailable, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </HeaderedContentControl.Header>
            <HeaderedContentControl.Content>
                <!-- Spinner replaces the label while registration (network wait, hardware scan, CreateSession) runs. -->
                <ui:Button Appearance="Primary"
                           Style="{StaticResource FooterActionButtonStyle}"
                           Command="{Binding ContinueCommand}"
                           IsEnabled="{Binding CanContinue}">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Continue" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="16" Height="16"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ui:Button>
            </HeaderedContentControl.Content>
        </HeaderedContentControl>
    </Grid>
</Page>
