<Page x:Class="CloudImaging.Client.Views.StartupView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Getting ready">
    <!--
        First screen after launch: checks the prerequisites every operation depends on (StartupViewModel)
        so Operation Selection opens in its final state. Fixed layout, no ScrollViewer (FR-002b).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
            <TextBlock Text="Getting ready"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Loading components and available operations"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />

            <Border Margin="0,24,0,0" Padding="20,8" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding IsPassed, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="18"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding IsWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="18"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="SubtractCircle24" FontSize="18"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <DockPanel>
                                        <!-- Tint under the label: an Opacity on the pill itself would fade the text too. -->
                                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                              Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                            <Border CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="8,1" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <!-- Mode=OneWay: ProgressBar.Value binds TwoWay by default, and Percent is read-only. -->
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="4"
                                                 Margin="0,6,0,0"
                                                 Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Hidden rather than collapsed, so the checks never move when it appears. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTryingWifi}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Plug in Ethernet at any time. It is used as soon as it has an address."
                           Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- No actions while checking; View Log is there for a check that hangs. Restart now ends a boot image update. -->
        <HeaderedContentControl Grid.Row="1" Style="{StaticResource ClientFooterStyle}">
            <HeaderedContentControl.Content>
                <ui:Button Content="Restart now"
                           Appearance="Primary"
                           Style="{StaticResource FooterActionButtonStyle}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Command="{Binding RestartCommand}"
                           Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}" />
            </HeaderedContentControl.Content>
        </HeaderedContentControl>
    </Grid>
</Page>
