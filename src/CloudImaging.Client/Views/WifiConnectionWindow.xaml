<ui:FluentWindow x:Class="CloudImaging.Client.Views.WifiConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Connect to Wi-Fi"
        Width="480" Height="580"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <!--
        Support tool (FR-051d companion feature): lets a technician connect this WinPE session to
        a Wi-Fi network without leaving the Client. Mirrors LogViewerWindow's chrome pattern
        (WindowStyle="None" + ExtendsContentIntoTitleBar + NativeWindowChromeFix in code-behind —
        required because WinPE doesn't run full DWM composition).
    -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Connect to Wi-Fi" ShowMaximize="False" />

        <!-- Network list -->
        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Available networks" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ui:Button Grid.Column="1" Content="Refresh" Appearance="Secondary"
                           Command="{Binding RefreshCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Networks}"
                     SelectedItem="{Binding SelectedNetwork}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsSupported}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding Ssid}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SignalPercent, StringFormat=' ({0}%)'}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NotSupportedLabel}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Status -->
        <ui:InfoBar Grid.Row="2" Margin="16,0,16,8"
                    Title="Error" Message="{Binding StatusMessage}"
                    Severity="Error" IsOpen="{Binding HasError}" IsClosable="False" />
        <ui:InfoBar Grid.Row="2" Margin="16,0,16,8"
                    Title="Connected" Message="{Binding StatusMessage}"
                    Severity="Success" IsOpen="{Binding HasSucceeded}" IsClosable="False" />

        <!-- Password entry (not bound — read directly from PasswordBox on Connect, standard WPF pattern) -->
        <StackPanel Grid.Row="3" Margin="16,0,16,8">
            <TextBlock Text="Password (leave blank for open networks)" Margin="0,0,0,4"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <PasswordBox x:Name="PasswordInput" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="Close" Appearance="Secondary" Margin="0,0,8,0" Click="CloseButton_Click" />
            <ui:Button Content="Connect" Appearance="Primary" Click="ConnectButton_Click"
                       IsEnabled="{Binding CanConnect}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
