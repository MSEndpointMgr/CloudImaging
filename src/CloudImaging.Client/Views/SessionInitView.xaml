<Page x:Class="CloudImaging.Client.Views.SessionInitView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Session Initializing">
    <!--
        FR-031: Displays session ID and one-time passcode while awaiting operator coupling.
        Transitions immediately to ResultsView on SessionNotAuthorized (FR-026).
        Refresh button triggers immediate poll cycle (FR-031).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,40">
            <StackPanel Width="520">

                <!-- Heading -->
                <TextBlock Text="Awaiting Session Coupling"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,0,0,28" />

                <!-- Passcode display -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="Session Passcode"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FormattedPasscode}"
                               FontSize="52" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SessionId, StringFormat='Session ID: {0}'}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Polling status -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20"
                            Visibility="{Binding IsPolling, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxHeight="60" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                    <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                     Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Certificate error -->
                <ui:InfoBar Title="Certificate Error"
                            Message="{Binding CertErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding HasCertError}"
                            IsClosable="False" />
            </StackPanel>
        </ui:Card>

        <!-- Start over stays available after polling stops: a rejected certificate or refused passcode leaves no other way forward short of rebooting. -->
        <HeaderedContentControl Grid.Row="1" Style="{StaticResource ClientFooterStyle}">
            <HeaderedContentControl.Content>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Start over"
                               Appearance="Secondary"
                               Style="{StaticResource FooterActionButtonStyle}"
                               Command="{Binding StartOverCommand}"
                               Visibility="{Binding CanStartOver, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Refresh status"
                               Appearance="Primary"
                               Style="{StaticResource FooterActionButtonStyle}"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               Visibility="{Binding IsPolling, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </HeaderedContentControl.Content>
        </HeaderedContentControl>
    </Grid>
</Page>
