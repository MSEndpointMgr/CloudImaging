<ui:FluentWindow x:Class="CloudImaging.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cloud Imaging"
        MinWidth="800" MinHeight="600"
        Width="800"   Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!--
        Sharpens every glyph rendered inside this window, including the WPF-UI SymbolIcon glyphs
        (Fluent icon font) on every hosted page: Display formatting mode pixel-snaps glyphs
        instead of WPF's default sub-pixel-positioned "Ideal" mode (which looks fuzzy at the
        small sizes used here), Grayscale rendering avoids ClearType color fringing on WinPE
        (no Themes/font-smoothing service, same reason WindowStyle=None is needed above), and
        UseLayoutRounding snaps control edges to whole device pixels. RenderOptions.BitmapScaling
        Mode applies to every raster Image in this window (e.g. branding\logo.png) instead of
        needing "HighQuality" repeated on each one. These are attached, inherited properties, so
        setting them once here is enough for every Page navigated into NavigationFrame below and
        every dialog Window owned by this one.
    -->
    <!--
        Fixed layout sized to fit the smallest default WinPE screen resolution:
        800×600 (also fits 1024×768 and larger, centered on display). No page-level
        scrolling — every view is laid out to fit within 800×600 (FR-002b).
        Fluent title bar for a consistent look with the Media Builder; backdrop is
        left at the default so the window renders correctly under WinPE (no DWM Mica).
        WindowStyle="None" is required alongside ExtendsContentIntoTitleBar: WinPE doesn't run
        the Themes service / full DWM composition, so without it Windows falls back to drawing
        the native XP/7-era "Basic" frame around the custom Fluent title bar instead of hiding it.
        Topmost keeps the Client above any other window in WinPE (there's no shell/taskbar,
        so nothing else should ever need to come to the foreground over it).
    -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Titled rather than blank: with ExtendsContentIntoTitleBar the bar occupies a full row
            above every hosted page regardless, so leaving it empty just reads as dead space at the
            top of dense pages (ProgressView especially). Matches the Media Builder's title bar.
        -->
        <ui:TitleBar Grid.Row="0"
                     ShowMaximize="False"
                     Background="{DynamicResource ApplicationBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="TitleBrandingLogo"
                           Width="18" Height="18"
                                    Margin="16,0,8,0"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           Visibility="Collapsed" />
                    <TextBlock Text="Cloud Imaging" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Frame x:Name="NavigationFrame"
                   NavigationUIVisibility="Hidden"
                   Focusable="False" />

            <!--
                Always-available diagnostics access point (FR-066): every screen already logs
                its requests/steps/payloads to the local rolling log, but WinPE has no
                Explorer/Notepad to open the file with — this lets a technician view it without
                leaving the app. Deliberately subtle (low opacity, corner-anchored) so it never
                competes with the actual imaging workflow.
            -->
            <ui:Button x:Name="ViewLogButton"
                       Appearance="Secondary"
                       FontSize="11"
                       Height="28"
                       Padding="10,0"
                       Opacity="0.7"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,16,16"
                       Click="ViewLogButton_Click">
                <StackPanel Orientation="Horizontal">
                    <!-- Explicit FontSize so the icon glyph isn't shrunk down to the button's
                         tiny 11pt label size (which otherwise renders as an indistinct blob). -->
                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Text="View Log" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <!--
            Dims this window while a modal child (LogViewerWindow, WifiConnectionWindow) is open
            on top of it. WinPE has no DWM composition, so the child window has no drop shadow
            and shares this window's exact background brush — without this overlay the two are
            visually indistinguishable when the child is centered over the owner. Spans both rows
            so the title bar dims too. IsHitTestVisible="False" because ShowDialog() already
            blocks input to this window at the Win32 level; this is purely a visual cue. Toggled
            via SetDimmed, see DialogHost.
        -->
        <Border x:Name="DimOverlay"
                Grid.Row="0" Grid.RowSpan="2"
                Background="#99000000"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>
