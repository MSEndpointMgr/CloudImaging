<ui:FluentWindow x:Class="CloudImaging.Client.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cloud Imaging Client — Log"
        Width="900" Height="600"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    <!--
        FR-066: every screen already logs its requests/steps/payloads to the local rolling log
        file, but WinPE has no Explorer/Notepad to open it with — this read-only viewer lets a
        technician inspect it without leaving the app. Local-only: it only reads the file already
        on disk and never uploads or transmits its contents (see Services.LogUploadService for the
        separate, best-effort failure-path upload).
    -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Cloud Imaging Client — Log"
                     ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Path shown in a read-only, selectable TextBox rather than a plain TextBlock, so its
                left/right edges line up exactly with the log content Border below (both use the
                same Grid.Column="0"/"*" width), and its text can be selected/copied directly in
                addition to the "Copy Path" button.
            -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,0,12,0">
                <!-- Neutralize the TextBox template's focus/hover chrome (see the matching
                     override in Media Builder's GenerateBootImageView log viewer) — out of place
                     on a read-only, console-style field. -->
                <Border.Resources>
                    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                </Border.Resources>
                <TextBox x:Name="LogPathText"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Background="Transparent" BorderThickness="0"
                         Padding="8,6"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Hidden" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Refresh" Appearance="Secondary" Click="RefreshButton_Click" />
                <ui:Button Content="Copy Path" Appearance="Secondary"
                           Margin="8,0,0,0" Click="CopyPathButton_Click" />
            </StackPanel>
        </Grid>


        <Border Grid.Row="2" Margin="16,0,16,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4">
            <!--
                The WPF UI TextBox control template's own PART_ContentHost ScrollViewer never
                surfaces a horizontal scrollbar thumb (only vertical), no matter what
                HorizontalScrollBarVisibility is set to on the TextBox itself, so long unwrapped
                log lines were readable only via keyboard — handing horizontal scrolling to an
                explicit outer ScrollViewer instead (Disabled on the TextBox so the two don't
                fight over the same axis) gets a real, visible horizontal scrollbar (mirrors
                Media Builder's GenerateBootImageView log viewer, which hit the same limitation).
                Vertical scrolling is still owned by the TextBox itself (Visible), which — unlike
                horizontal — does render correctly.

                Focusable="False" so this wrapper never keeps the default WPF focus-visual
                rectangle drawn around itself once the inner TextBox is clicked/selected.

                Horizontal Padding lives here rather than on the TextBox: this ScrollViewer (not
                the TextBox) now owns horizontal scrolling, and it's the ScrollViewer's own
                Padding that correctly extends into its scrollable extent on both sides.
            -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" Padding="10,0">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Visible"
                         HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,10"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
