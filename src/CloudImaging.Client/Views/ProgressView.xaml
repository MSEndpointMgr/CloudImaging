<Page x:Class="CloudImaging.Client.Views.ProgressView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Imaging in Progress">
    <!--
        FR-007: 3-node horizontal step indicator: Format, Download, Apply.
        Transitions to ResultsView on Apply complete.
    -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Imaging in Progress"
                   Style="{StaticResource TitleTextBlockStyle}"
                   HorizontalAlignment="Center" />

        <!-- 3-node step indicator -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Format Disk node -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Ellipse Width="40" Height="40" HorizontalAlignment="Center"
                         Fill="{Binding FormatStepColor}" />
                <TextBlock Text="✓" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,-36,0,0"
                           Visibility="{Binding FormatCompleted, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Format" Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Connector line -->
            <Rectangle Grid.Column="1" Height="2" Width="120"
                       Fill="{Binding DownloadStepColor}" VerticalAlignment="Center" />

            <!-- Download Image node -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <Ellipse Width="40" Height="40" HorizontalAlignment="Center"
                         Fill="{Binding DownloadStepColor}" />
                <TextBlock Text="✓" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,-36,0,0"
                           Visibility="{Binding DownloadCompleted, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Download" Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Connector line -->
            <Rectangle Grid.Column="3" Height="2" Width="120"
                       Fill="{Binding ApplyStepColor}" VerticalAlignment="Center" />

            <!-- Apply Image node -->
            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                <Ellipse Width="40" Height="40" HorizontalAlignment="Center"
                         Fill="{Binding ApplyStepColor}" />
                <TextBlock Text="✓" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,-36,0,0"
                           Visibility="{Binding ApplyCompleted, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Apply" Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Overall progress bar -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,10" />
            <ProgressBar Value="{Binding OverallPercent}" Minimum="0" Maximum="100"
                            Height="8" Width="500" />
            <TextBlock Text="{Binding OverallPercent, StringFormat='{}{0}%'}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Error section -->
        <ui:InfoBar Grid.Row="6"
                    Title="Imaging Failed"
                    Message="{Binding ErrorMessage}"
                    Severity="Error"
                    IsOpen="{Binding HasError}"
                    IsClosable="False">
            <ui:InfoBar.Footer>
                <TextBlock Text="{Binding SupportReferenceCode, StringFormat='Support ref: {0}'}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontFamily="Consolas"
                           Margin="0,4,0,0" />
            </ui:InfoBar.Footer>
        </ui:InfoBar>
    </Grid>
</Page>
