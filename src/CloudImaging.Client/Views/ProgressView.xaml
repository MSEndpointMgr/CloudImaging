<Page x:Class="CloudImaging.Client.Views.ProgressView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Imaging in Progress">
    <!--
        FR-007: split hero + step-sidebar layout. Left sidebar lists the 5-step pipeline
        (Format, Download, Apply, Configure Boot, Apply Recovery) with a small dot + label +
        caption per step (mirrors CloudImaging.MediaBuilder's GenerateBootImageView step list).
        The right "hero" panel shows a continuously-spinning (indeterminate) progress ring next
        to the current step's title/subtitle — the overall session percentage is shown as text
        over the ring, so the ring itself only needs to communicate "still working", not the
        value — a short live-activity ticker underneath (the same StatusMessage strings
        ImagingWorkflowViewModel already sets), and a progress bar scoped to the step that is
        currently running (download / apply / recovery), with the real downloaded-vs-total byte
        counts under it while a transfer is in flight. No fabricated speed or time-remaining
        telemetry, since the pipeline doesn't expose any. Sized to fit the fixed 800x600 WinPE
        window with no page-level scrolling (FR-002b).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Step sidebar -->
        <Border Grid.Column="0"
                Padding="24,14,18,24"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                <TextBlock Text="Steps"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Ellipse Width="12" Height="12" StrokeThickness="2"
                                         VerticalAlignment="Top" Margin="0,3,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Active">
                                                    <Setter Property="Stroke" Value="{DynamicResource SystemAccentColorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="146">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Active">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Caption}"
                                               FontSize="11"
                                               TextWrapping="Wrap" MaxWidth="146"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>

                <ui:Button Grid.Row="2"
                           Appearance="Secondary"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           FontSize="12"
                           Padding="0,8"
                           Margin="0,16,0,0"
                           Click="ViewLogButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,6,0" />
                        <TextBlock Text="View Log" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Hero panel -->
        <Grid Grid.Column="1" Margin="32,14,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Ring + title/subtitle -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <Grid Width="52" Height="52" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="52" Height="52" />
                    <TextBlock Text="{Binding OverallPercent, StringFormat='{}{0}%'}"
                               FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding CurrentStepTitle}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{Binding StepSubtitle}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Activity ticker -->
            <Border Grid.Row="1"
                    Margin="0,0,0,16"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Border.Resources>
                    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                </Border.Resources>
                <!-- One viewer owns both axes. Nesting this around a scrolling TextBox produced
                     two independent extents: the outer bar reached its maximum while the
                     TextBox's PART_ContentHost still clipped the end of the line. -->
                <ScrollViewer x:Name="ActivityLogScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="ActivityLogScrollViewer_ScrollChanged"
                              Focusable="False">
                    <TextBlock Text="{Binding LogText, Mode=OneWay}"
                               Padding="12,10"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>

            <!--
                Step progress: how far through the operation running right now, not the session
                as a whole (that number sits over the ring). Steps that can't report progress
                leave this empty rather than showing an invented value.
            -->
            <StackPanel Grid.Row="2" Margin="0,0,0,0">
                <ProgressBar Value="{Binding StepPercent}" Minimum="0" Maximum="100" Height="6" />
                <TextBlock Text="{Binding TransferDetail, Mode=OneWay}"
                           Visibility="{Binding HasTransferDetail, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,6,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Error section — accent-strip design (icon + title, selectable message, no boxed InfoBar) -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="20" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="Imaging Failed" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Style="{StaticResource SelectableMessageTextBoxStyle}"
                         Text="{Binding ErrorMessage, Mode=OneWay}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         TextAlignment="Center"
                         Margin="0,8,0,0" />
                <TextBlock Text="{Binding SupportReferenceCode, StringFormat='Error ref: {0}'}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
