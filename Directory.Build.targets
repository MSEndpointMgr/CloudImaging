<Project>

  <!--
    WPF SDK workaround (net10.0 + WPF-UI + source generators):

    The XAML markup compiler creates a temporary project (_wpftmp.csproj) that inherits all
    @(Compile) source files and NuGet analyzer DLLs from the parent project. When Roslyn's
    LoggerMessageGenerator runs in the temp project it produces the same partial-method
    implementations that the parent project already compiled, causing CS0102/CS0111 duplicates.

    The temp project exists only to let the XAML compiler resolve types referenced in markup.
    It does NOT need service or view-model code (which is never referenced by XAML directly).

    Fix: In the _wpftmp context, strip the source files that carry [LoggerMessage] declarations
    (Services, ViewModels, Logging, App.xaml.cs) from @(Compile) so the generator never fires.
    Converters and View code-behind are kept because XAML references those types explicitly.
  -->
  <Target Name="FixWpfTempProjectSourceGenerators"
          BeforeTargets="CoreCompile"
          Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <!-- Remove files that carry [LoggerMessage] declarations; not needed for XAML type resolution -->
      <Compile Remove="Services\**\*.cs" />
      <Compile Remove="ViewModels\**\*.cs" />
      <Compile Remove="Logging\**\*.cs" />
      <!-- App.xaml.cs instantiates services; the XAML-generated App.g.cs is sufficient for the temp project -->
      <Compile Remove="App.xaml.cs" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <CheckForPackageUpdatesOnBuild Condition="'$(CheckForPackageUpdatesOnBuild)' == ''">true</CheckForPackageUpdatesOnBuild>
  </PropertyGroup>

  <Target Name="CheckForOutdatedPackages"
          AfterTargets="Build"
          Condition="'$(CheckForPackageUpdatesOnBuild)' == 'true'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(IsCrossTargetingBuild)' != 'true'
                     and '$(CI_SKIP_PACKAGE_UPDATE_CHECK)' != '1'
                     and '$(MSBuildProjectExtension)' == '.csproj'">
    <Exec Command="dotnet list &quot;$(MSBuildProjectFullPath)&quot; package --outdated"
          ConsoleToMsBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          EnvironmentVariables="CI_SKIP_PACKAGE_UPDATE_CHECK=1">
      <Output TaskParameter="ConsoleOutput" ItemName="_PackageUpdateCheckOutput" />
    </Exec>

    <ItemGroup>
      <!-- Exclude pinned packages (e.g., FluentAssertions is pinned to v7.x because the license model changed in v8+) -->
      <_OutdatedPackageLines Include="@(_PackageUpdateCheckOutput)"
                             Condition="$([System.String]::Copy('%(_PackageUpdateCheckOutput.Identity)').Trim().StartsWith('>'))
                                        and !$([System.String]::Copy('%(_PackageUpdateCheckOutput.Identity)').Contains('FluentAssertions'))" />
    </ItemGroup>

    <Warning Text="NuGet package update available: %(_OutdatedPackageLines.Identity)"
             Condition="'@(_OutdatedPackageLines)' != ''" />
  </Target>

</Project>

